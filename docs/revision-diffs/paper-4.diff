+    "    which=\"major\",\n",
+    "    width=2.0,\n",
+    "    length=7\n",
+    ")\n",
+    "\n",
+    "ax.tick_params(axis=\"x\", pad=10)\n",
+    "\n",
+    "# ============================================================\n",
+    "# 13. 여백\n",
+    "# ============================================================\n",
+    "plt.tight_layout()\n",
+    "\n",
+    "# ============================================================\n",
