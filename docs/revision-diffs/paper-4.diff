+        "plt.rcParams[\"font.family\"] = font_bold.get_name()\n",
+        "plt.rcParams[\"axes.unicode_minus\"] = False\n",
+        "\n",
+        "# ============================================================\n",
+        "# 2. 최종 확정 32명 평가 데이터\n",
+        "#    ※ 논문 표 4의 통계값과 일치\n",
+        "# ============================================================\n",
+        "\n",
+        "# Emotional Appropriateness\n",
+        "# 3점 2명 / 4점 10명 / 5점 20명\n",
+        "emotional_appropriateness = (\n",
+        "    [3] * 2 +\n",
+        "    [4] * 10 +\n",
+        "    [5] * 20\n",
+        ")\n",
+        "\n",
+        "# Language Naturalness\n",
+        "# 3점 1명 / 4점 5명 / 5점 26명\n",
+        "language_naturalness = (\n",
+        "    [3] * 1 +\n",
+        "    [4] * 5 +\n",
+        "    [5] * 26\n",
+        ")\n",
+        "\n",
+        "# Empathy\n",
+        "# 3점 2명 / 4점 12명 / 5점 18명\n",
+        "empathy = (\n",
+        "    [3] * 2 +\n",
+        "    [4] * 12 +\n",
+        "    [5] * 18\n",
+        ")\n",
+        "\n",
+        "data = [\n",
+        "    emotional_appropriateness,\n",
+        "    language_naturalness,\n",
+        "    empathy\n",
+        "]\n",
+        "\n",
+        "labels = [\n",
+        "    \"Emotional\\nAppropriateness\",\n",
+        "    \"Language\\nNaturalness\",\n",
+        "    \"Empathy\"\n",
+        "]\n",
+        "\n",
+        "# ============================================================\n",
+        "# 3. 참가자 수 확인\n",
+        "# ============================================================\n",
+        "print(\"===== Participant Count =====\")\n",
+        "\n",
+        "for label, values in zip(labels, data):\n",
+        "    print(f\"{label.replace(chr(10), ' ')} : {len(values)}명\")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 4. 통계 확인\n",
+        "# ============================================================\n",
+        "print(\"\\n===== Statistics =====\")\n",
+        "\n",
+        "for label, values in zip(labels, data):\n",
+        "    values = np.array(values, dtype=float)\n",
+        "\n",
+        "    mean = np.mean(values)\n",
+        "    median = np.median(values)\n",
+        "    sd = np.std(values, ddof=1)\n",
+        "    q1 = np.percentile(values, 25)\n",
+        "    q3 = np.percentile(values, 75)\n",
+        "\n",
+        "    print(f\"\\n[{label.replace(chr(10), ' ')}]\")\n",
+        "    print(f\"Mean   = {mean:.4f} → {mean:.1f}\")\n",
+        "    print(f\"Median = {median:.1f}\")\n",
+        "    print(f\"SD     = {sd:.4f} → {sd:.2f}\")\n",
+        "    print(f\"Q1     = {q1:.1f}\")\n",
+        "    print(f\"Q3     = {q3:.1f}\")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 5. Box Plot\n",
+        "# ============================================================\n",
+        "fig, ax = plt.subplots(figsize=(11, 8))\n",
+        "\n",
+        "bp = ax.boxplot(\n",
+        "    data,\n",
+        "    widths=0.58,\n",
+        "    patch_artist=True,\n",
+        "    showmeans=False,\n",
+        "    showfliers=True,\n",
+        "\n",
+        "    # Box\n",
+        "    boxprops=dict(\n",
+        "        linewidth=3.2,\n",
+        "        edgecolor=\"black\",\n",
+        "        facecolor=\"#BFE7F5\"\n",
+        "    ),\n",
+        "\n",
+        "    # Median\n",
+        "    medianprops=dict(\n",
+        "        linewidth=4.0,\n",
+        "        color=\"black\"\n",
+        "    ),\n",
+        "\n",
+        "    # Whisker\n",
+        "    whiskerprops=dict(\n",
+        "        linewidth=3.0,\n",
+        "        color=\"black\"\n",
+        "    ),\n",
+        "\n",
+        "    # Cap\n",
+        "    capprops=dict(\n",
+        "        linewidth=3.0,\n",
+        "        color=\"black\"\n",
+        "    ),\n",
+        "\n",
+        "    # Outlier\n",
+        "    flierprops=dict(\n",
+        "        marker=\"o\",\n",
+        "        markersize=8,\n",
+        "        markerfacecolor=\"white\",\n",
+        "        markeredgecolor=\"black\",\n",
+        "        markeredgewidth=2.0\n",
+        "    )\n",
+        ")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 6. 박스 하늘색 적용\n",
+        "# ============================================================\n",
+        "for patch in bp[\"boxes\"]:\n",
+        "    patch.set_facecolor(\"#BFE7F5\")\n",
+        "    patch.set_edgecolor(\"black\")\n",
+        "    patch.set_linewidth(3.2)\n",
+        "\n",
+        "# ============================================================\n",
+        "# 7. X축 / Y축\n",
+        "# ============================================================\n",
+        "ax.set_xticks([1, 2, 3])\n",
+        "ax.set_xticklabels(labels)\n",
+        "\n",
+        "ax.set_xlabel(\n",
+        "    \"Evaluation Item\",\n",
+        "    fontproperties=font_bold,\n",
+        "    fontsize=27,\n",
+        "    fontweight=\"bold\",\n",
+        "    labelpad=12\n",
+        ")\n",
+        "\n",
+        "ax.set_ylabel(\n",
+        "    \"Likert Score\",\n",
+        "    fontproperties=font_bold,\n",
+        "    fontsize=27,\n",
+        "    fontweight=\"bold\",\n",
+        "    labelpad=12\n",
+        ")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 8. 축 눈금 전부 Bold\n",
+        "# ============================================================\n",
+        "for tick in ax.get_xticklabels():\n",
+        "    tick.set_fontproperties(font_bold)\n",
+        "    tick.set_fontsize(18)\n",
+        "    tick.set_fontweight(\"bold\")\n",
+        "\n",
+        "for tick in ax.get_yticklabels():\n",
+        "    tick.set_fontproperties(font_bold)\n",
+        "    tick.set_fontsize(18)\n",
+        "    tick.set_fontweight(\"bold\")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 9. Y축 범위\n",
+        "# ============================================================\n",
+        "ax.set_ylim(0.8, 5.2)\n",
+        "ax.set_yticks([1, 2, 3, 4, 5])\n",
+        "\n",
+        "# ============================================================\n",
+        "# 10. Grid\n",
+        "# ============================================================\n",
+        "ax.grid(\n",
+        "    axis=\"y\",\n",
+        "    linestyle=\"--\",\n",
+        "    linewidth=1.0,\n",
+        "    alpha=0.35\n",
+        ")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 11. 테두리\n",
+        "# ============================================================\n",
+        "ax.spines[\"top\"].set_visible(False)\n",
+        "ax.spines[\"right\"].set_visible(False)\n",
+        "\n",
+        "ax.spines[\"left\"].set_linewidth(2.5)\n",
+        "ax.spines[\"bottom\"].set_linewidth(2.5)\n",
+        "\n",
+        "# ============================================================\n",
+        "# 12. 눈금선\n",
+        "# ============================================================\n",
+        "ax.tick_params(\n",
+        "    axis=\"both\",\n",
+        "    which=\"major\",\n",
+        "    width=2.0,\n",
+        "    length=7\n",
+        ")\n",
+        "\n",
+        "ax.tick_params(axis=\"x\", pad=10)\n",
+        "\n",
+        "# ============================================================\n",
+        "# 13. 여백\n",
+        "# ============================================================\n",
+        "plt.tight_layout()\n",
+        "\n",
+        "# ============================================================\n",
+        "# 14. 저장\n",
+        "# ============================================================\n",
+        "SAVE_PATH = \"/content/user_evaluation_boxplot_skyblue.png\"\n",
+        "\n",
+        "plt.savefig(\n",
+        "    SAVE_PATH,\n",
+        "    dpi=600,\n",
+        "    bbox_inches=\"tight\",\n",
+        "    facecolor=\"white\"\n",
+        ")\n",
+        "\n",
+        "plt.show()\n",
+        "\n",
+        "print(f\"\\nSaved to: {SAVE_PATH}\")\n",
+        "\n",
+        "# ============================================================\n",
+        "# 15. 이미지 다운로드\n",
+        "# ============================================================\n",
+        "files.download(SAVE_PATH)"
+      ]
+    },
