+    "    tick.set_fontsize(18)\n",
+    "    tick.set_fontweight(\"bold\")\n",
+    "\n",
+    "for tick in ax.get_yticklabels():\n",
+    "    tick.set_fontproperties(font_bold)\n",
+    "    tick.set_fontsize(18)\n",
+    "    tick.set_fontweight(\"bold\")\n",
+    "\n",
+    "# ============================================================\n",
+    "# 9. Y축 범위\n",
+    "# ============================================================\n",
+    "ax.set_ylim(0.8, 5.2)\n",
+    "ax.set_yticks([1, 2, 3, 4, 5])\n",
+    "\n",
+    "# ============================================================\n",
+    "# 10. Grid\n",
+    "# ============================================================\n",
+    "ax.grid(\n",
+    "    axis=\"y\",\n",
+    "    linestyle=\"--\",\n",
