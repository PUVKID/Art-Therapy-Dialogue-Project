+    "for patch in bp[\"boxes\"]:\n",
+    "    patch.set_facecolor(\"#BFE7F5\")\n",
+    "    patch.set_edgecolor(\"black\")\n",
+    "    patch.set_linewidth(3.2)\n",
+    "\n",
+    "# ============================================================\n",
+    "# 7. X축 / Y축\n",
+    "# ============================================================\n",
+    "ax.set_xticks([1, 2, 3])\n",
+    "ax.set_xticklabels(labels)\n",
+    "\n",
+    "ax.set_xlabel(\n",
+    "    \"Evaluation Item\",\n",
+    "    fontproperties=font_bold,\n",
+    "    fontsize=27,\n",
+    "    fontweight=\"bold\",\n",
+    "    labelpad=12\n",
+    ")\n",
+    "\n",
+    "ax.set_ylabel(\n",
+    "    \"Likert Score\",\n",
+    "    fontproperties=font_bold,\n",
+    "    fontsize=27,\n",
+    "    fontweight=\"bold\",\n",
+    "    labelpad=12\n",
+    ")\n",
+    "\n",
+    "# ============================================================\n",
+    "# 8. 축 눈금 전부 Bold\n",
+    "# ============================================================\n",
+    "for tick in ax.get_xticklabels():\n",
